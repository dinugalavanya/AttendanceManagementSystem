@model AttendanceManagementSystem.ViewModels.DashboardViewModel
@using System.Text.Json
@using AttendanceManagementSystem.Models

@{
    ViewData["Title"] = "Leave Agent Dashboard";

    var today = Model.SelectedDate;
    var monthLabel = Model.OTCurrentMonthLabel != string.Empty ? Model.OTCurrentMonthLabel : today.ToString("MMMM yyyy");
    var sectionName = Model.ScopeTitle.Replace(" Overview", "").Trim();

    // Chart data serialisation
    var deptLabelsJson  = JsonSerializer.Serialize(Model.DepartmentOTLabels ?? new());
    var deptValuesJson  = JsonSerializer.Serialize(Model.DepartmentOTValues  ?? new());
    var dailyLabelsJson = JsonSerializer.Serialize(Model.DailyOTLabels       ?? new());
    var dailyValuesJson = JsonSerializer.Serialize(Model.DailyOTValues       ?? new());
    var distLabelsJson  = JsonSerializer.Serialize(Model.OTDistributionLabels ?? new());
    var distValuesJson  = JsonSerializer.Serialize(Model.OTDistributionValues  ?? new());

    // Calendar data
    var calDays = Model.OTCalendarDays ?? new();
    var employees = Model.OTEmployees  ?? new();
    var alerts    = Model.OTAlerts     ?? new();
    var summary   = Model.OTSummary    ?? new();
    var todayStatus = Model.TodayOTStatus ?? new();

    // Derived stats
    var pendingCount = summary.Employees95to100 + summary.EmployeesAbove100;
    var approvedToday = Model.PresentCount;
    var onLeaveToday = todayStatus.EmployeesOnLeave;
    var urgentCount = summary.EmployeesAbove100;
}

<!-- ═══════════════════════════════════════════════════════════════
     LEAVE AGENT DASHBOARD  –  Premium Enterprise HR Dashboard
     ═══════════════════════════════════════════════════════════════ -->

<style>
    /* ══════════════════════════════════════════════════════════════
       DESIGN TOKENS
       ══════════════════════════════════════════════════════════════ */
    :root {
        --ld-blue:        #2563EB;
        --ld-blue-lt:     #3B82F6;
        --ld-blue-xlt:    #EFF6FF;
        --ld-blue-dk:     #1D4ED8;
        --ld-emerald:     #10B981;
        --ld-emerald-lt:  #34D399;
        --ld-emerald-xlt: #ECFDF5;
        --ld-violet:      #7C3AED;
        --ld-violet-lt:   #8B5CF6;
        --ld-violet-xlt:  #EDE9FE;
        --ld-orange:      #F59E0B;
        --ld-orange-lt:   #FBBF24;
        --ld-orange-xlt:  #FEF3C7;
        --ld-red:         #EF4444;
        --ld-red-lt:      #F87171;
        --ld-red-xlt:     #FEE2E2;
        --ld-green:       #16A34A;
        --ld-surface:     #F8FAFC;
        --ld-card:        #FFFFFF;
        --ld-border:      #E2E8F0;
        --ld-border-lt:   #F1F5F9;
        --ld-text:        #0F172A;
        --ld-text-secondary: #475569;
        --ld-muted:       #94A3B8;
        --ld-radius:      20px;
        --ld-radius-sm:   14px;
        --ld-radius-xs:   10px;
        --ld-shadow:      0 1px 3px rgba(0,0,0,.04), 0 4px 16px rgba(0,0,0,.06);
        --ld-shadow-md:   0 4px 6px -1px rgba(0,0,0,.07), 0 10px 30px -4px rgba(0,0,0,.08);
        --ld-shadow-lg:   0 10px 40px -8px rgba(0,0,0,.12);
        --ld-shadow-glow: 0 0 40px rgba(37,99,235,.12);
        --ld-transition:  all .25s cubic-bezier(.4,0,.2,1);
    }

    /* ══════════════════════════════════════════════════════════════
       PAGE LAYOUT
       ══════════════════════════════════════════════════════════════ */
    .ld-page {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        padding-bottom: 3rem;
        max-width: 1600px;
        margin: 0 auto;
    }

    /* ══════════════════════════════════════════════════════════════
       HERO BANNER
       ══════════════════════════════════════════════════════════════ */
    .ld-hero {
        background: linear-gradient(135deg, #1E40AF 0%, #2563EB 30%, #7C3AED 70%, #6D28D9 100%);
        border-radius: var(--ld-radius);
        padding: 2rem 2.5rem;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        box-shadow: var(--ld-shadow-lg), 0 0 60px rgba(37,99,235,.15);
        position: relative;
        overflow: hidden;
    }
    .ld-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(255,255,255,.08) 0%, transparent 70%);
        border-radius: 50%;
    }
    .ld-hero::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: 20%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(16,185,129,.15) 0%, transparent 70%);
        border-radius: 50%;
    }
    .ld-hero-left { position: relative; z-index: 2; }
    .ld-hero-eyebrow {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        opacity: .75;
        margin-bottom: .5rem;
        display: flex;
        align-items: center;
        gap: .4rem;
    }
    .ld-hero h1 {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 0 0 .35rem;
        letter-spacing: -.02em;
    }
    .ld-hero-sub { font-size: .9rem; opacity: .8; margin: 0; }
    .ld-hero-right { position: relative; z-index: 2; display: flex; gap: .75rem; flex-wrap: wrap; }
    .ld-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: .45rem 1rem;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 600;
        color: #fff;
        transition: var(--ld-transition);
    }
    .ld-hero-badge:hover {
        background: rgba(255,255,255,.2);
        transform: translateY(-1px);
    }

    /* ══════════════════════════════════════════════════════════════
       ANALYTICS CARDS (ROW 1)
       ══════════════════════════════════════════════════════════════ */
    .ld-stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
    }
    @@media(max-width: 1024px) { .ld-stats-row { grid-template-columns: repeat(2, 1fr); } }
    @@media(max-width: 540px) { .ld-stats-row { grid-template-columns: 1fr; } }

    .ld-stat-card {
        background: var(--ld-card);
        border: 1px solid var(--ld-border);
        border-radius: var(--ld-radius);
        padding: 1.5rem 1.75rem;
        box-shadow: var(--ld-shadow);
        display: flex;
        align-items: flex-start;
        gap: 1.15rem;
        transition: var(--ld-transition);
        position: relative;
        overflow: hidden;
    }
    .ld-stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        border-radius: var(--ld-radius) var(--ld-radius) 0 0;
    }
    .ld-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--ld-shadow-md);
    }
    .ld-stat-card.orange::before { background: linear-gradient(90deg, #F59E0B, #FBBF24); }
    .ld-stat-card.green::before  { background: linear-gradient(90deg, #10B981, #34D399); }
    .ld-stat-card.blue::before   { background: linear-gradient(90deg, #2563EB, #3B82F6); }
    .ld-stat-card.red::before    { background: linear-gradient(90deg, #EF4444, #F87171); }

    .ld-stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }
    .ld-stat-icon.orange { background: var(--ld-orange-xlt); color: var(--ld-orange); }
    .ld-stat-icon.green  { background: var(--ld-emerald-xlt); color: var(--ld-emerald); }
    .ld-stat-icon.blue   { background: var(--ld-blue-xlt); color: var(--ld-blue); }
    .ld-stat-icon.red    { background: var(--ld-red-xlt); color: var(--ld-red); }

    .ld-stat-info { flex: 1; }
    .ld-stat-label {
        font-size: .78rem;
        font-weight: 600;
        color: var(--ld-muted);
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: .3rem;
    }
    .ld-stat-value {
        font-size: 2rem;
        font-weight: 800;
        color: var(--ld-text);
        line-height: 1.1;
        font-family: var(--font-heading);
    }
    .ld-stat-change {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        font-size: .72rem;
        font-weight: 700;
        margin-top: .35rem;
        padding: .2rem .55rem;
        border-radius: 999px;
    }
    .ld-stat-change.up   { background: #DCFCE7; color: #15803D; }
    .ld-stat-change.down { background: #FEE2E2; color: #991B1B; }

    /* ══════════════════════════════════════════════════════════════
       SHARED CARD COMPONENT
       ══════════════════════════════════════════════════════════════ */
    .ld-card {
        background: var(--ld-card);
        border: 1px solid var(--ld-border);
        border-radius: var(--ld-radius);
        box-shadow: var(--ld-shadow);
        overflow: hidden;
        transition: var(--ld-transition);
    }
    .ld-card:hover {
        box-shadow: var(--ld-shadow-md);
    }
    .ld-card-header {
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid var(--ld-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        background: linear-gradient(180deg, rgba(248,250,252,.7), rgba(255,255,255,0));
    }
    .ld-card-title {
        font-size: .95rem;
        font-weight: 700;
        color: var(--ld-text);
        margin: 0;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
    .ld-card-title i { font-size: 1.1rem; }
    .ld-card-body { padding: 1.5rem; }

    /* ══════════════════════════════════════════════════════════════
       SECOND ROW (Table 70% + Summary 30%)
       ══════════════════════════════════════════════════════════════ */
    .ld-row-2 {
        display: grid;
        grid-template-columns: 7fr 3fr;
        gap: 1.25rem;
        align-items: start;
    }
    @@media(max-width: 1100px) { .ld-row-2 { grid-template-columns: 1fr; } }

    /* ── Leave Approval Queue Table ────────────────────────────── */
    .ld-table-wrap { overflow-x: auto; }
    .ld-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    .ld-table thead th {
        text-align: left;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--ld-muted);
        padding: .85rem 1rem;
        border-bottom: 2px solid var(--ld-border);
        background: #FAFBFD;
        position: sticky;
        top: 0;
        z-index: 5;
        white-space: nowrap;
    }
    .ld-table tbody tr {
        transition: var(--ld-transition);
        border-bottom: 1px solid var(--ld-border-lt);
    }
    .ld-table tbody tr:hover {
        background: linear-gradient(90deg, #EFF6FF 0%, #EDE9FE 100%);
    }
    .ld-table td {
        padding: .85rem 1rem;
        vertical-align: middle;
        font-size: .875rem;
        color: var(--ld-text-secondary);
        white-space: nowrap;
    }

    /* Avatar + Name cell */
    .ld-emp-cell {
        display: flex;
        align-items: center;
        gap: .75rem;
    }
    .ld-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: .78rem;
        font-weight: 700;
        flex-shrink: 0;
    }
    .ld-avatar.v1 { background: linear-gradient(135deg, #2563EB, #3B82F6); }
    .ld-avatar.v2 { background: linear-gradient(135deg, #7C3AED, #8B5CF6); }
    .ld-avatar.v3 { background: linear-gradient(135deg, #10B981, #34D399); }
    .ld-avatar.v4 { background: linear-gradient(135deg, #F59E0B, #FBBF24); }
    .ld-avatar.v5 { background: linear-gradient(135deg, #EF4444, #F87171); }
    .ld-emp-name { font-weight: 700; color: var(--ld-text); font-size: .875rem; }
    .ld-emp-id { font-size: .72rem; color: var(--ld-muted); }

    /* Status badges */
    .ld-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .28rem .7rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .02em;
    }
    .ld-badge.pending  { background: var(--ld-orange-xlt); color: #92400E; }
    .ld-badge.approved { background: var(--ld-emerald-xlt); color: #065F46; }
    .ld-badge.rejected { background: var(--ld-red-xlt); color: #991B1B; }
    .ld-badge.urgent   { background: var(--ld-red-xlt); color: #991B1B; }

    /* Priority badges */
    .ld-priority {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .2rem .6rem;
        border-radius: 6px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .ld-priority.high   { background: #FEE2E2; color: #DC2626; }
    .ld-priority.medium { background: #FEF3C7; color: #D97706; }
    .ld-priority.low    { background: #DCFCE7; color: #16A34A; }

    /* Action buttons */
    .ld-action-btns { display: flex; gap: .4rem; }
    .ld-btn-sm {
        padding: .35rem .65rem;
        border-radius: 8px;
        font-size: .72rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: var(--ld-transition);
        display: inline-flex;
        align-items: center;
        gap: .3rem;
    }
    .ld-btn-sm:hover { transform: translateY(-1px); }
    .ld-btn-approve {
        background: linear-gradient(135deg, #10B981, #059669);
        color: #fff;
    }
    .ld-btn-approve:hover { box-shadow: 0 4px 12px rgba(16,185,129,.3); }
    .ld-btn-reject {
        background: linear-gradient(135deg, #EF4444, #DC2626);
        color: #fff;
    }
    .ld-btn-reject:hover { box-shadow: 0 4px 12px rgba(239,68,68,.3); }
    .ld-btn-view {
        background: var(--ld-blue-xlt);
        color: var(--ld-blue);
        border: 1px solid #BFDBFE;
    }
    .ld-btn-view:hover { background: #DBEAFE; }

    /* ── Summary Card (Right 30%) ─────────────────────────────── */
    .ld-summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .85rem;
        margin-bottom: 1.25rem;
    }
    .ld-summary-item {
        background: var(--ld-surface);
        border-radius: var(--ld-radius-xs);
        padding: 1rem;
        text-align: center;
        transition: var(--ld-transition);
    }
    .ld-summary-item:hover { background: var(--ld-blue-xlt); }
    .ld-summary-value {
        font-size: 1.6rem;
        font-weight: 800;
        line-height: 1.1;
        font-family: var(--font-heading);
    }
    .ld-summary-label {
        font-size: .7rem;
        font-weight: 600;
        color: var(--ld-muted);
        margin-top: .25rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .ld-donut-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: .5rem 0;
    }

    /* ══════════════════════════════════════════════════════════════
       THIRD ROW (Calendar + Leave Balance)
       ══════════════════════════════════════════════════════════════ */
    .ld-row-3 {
        display: grid;
        grid-template-columns: 6fr 4fr;
        gap: 1.25rem;
        align-items: start;
    }
    @@media(max-width: 1100px) { .ld-row-3 { grid-template-columns: 1fr; } }

    /* Calendar */
    .ld-cal-grid-wrap { overflow-x: auto; }
    .ld-cal-table { width: 100%; border-collapse: collapse; }
    .ld-cal-table th {
        text-align: center;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--ld-muted);
        padding: .6rem .25rem;
        border-bottom: 2px solid var(--ld-border);
    }
    .ld-cal-table td {
        text-align: center;
        padding: .5rem .3rem;
        border: 1px solid var(--ld-border-lt);
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        min-width: 42px;
        height: 42px;
        transition: var(--ld-transition);
        border-radius: 4px;
    }
    .ld-cal-table td:hover:not(.cal-empty) {
        transform: scale(1.08);
        box-shadow: var(--ld-shadow);
    }
    .ld-cal-table td.cal-empty { background: transparent; border-color: transparent; cursor: default; }
    .cal-available  { background: #DCFCE7; color: #15803D; }
    .cal-approved   { background: #DBEAFE; color: #1D4ED8; }
    .cal-pending    { background: #FEF3C7; color: #92400E; }
    .cal-holiday    { background: #FEE2E2; color: #991B1B; }
    .cal-event      { background: #EDE9FE; color: #6D28D9; }
    .cal-today {
        outline: 2.5px solid var(--ld-blue);
        outline-offset: -2px;
        font-weight: 800;
    }

    .ld-cal-legend {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        padding: 1rem 1.5rem;
        background: #FAFBFD;
        border-top: 1px solid var(--ld-border);
    }
    .ld-cal-legend-item {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-size: .72rem;
        font-weight: 600;
        color: var(--ld-text-secondary);
    }
    .ld-cal-swatch {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        display: inline-block;
    }

    /* Leave Balance Progress Bars */
    .ld-balance-list { display: flex; flex-direction: column; gap: 1.25rem; }
    .ld-balance-item { }
    .ld-balance-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: .5rem;
    }
    .ld-balance-name {
        font-size: .85rem;
        font-weight: 700;
        color: var(--ld-text);
    }
    .ld-balance-pct {
        font-size: .78rem;
        font-weight: 700;
    }
    .ld-balance-bar {
        height: 10px;
        background: var(--ld-border-lt);
        border-radius: 999px;
        overflow: hidden;
    }
    .ld-balance-fill {
        height: 100%;
        border-radius: 999px;
        transition: width .6s ease;
    }

    /* ══════════════════════════════════════════════════════════════
       FOURTH ROW — Activity Timeline
       ══════════════════════════════════════════════════════════════ */
    .ld-timeline { display: flex; flex-direction: column; gap: 0; }
    .ld-timeline-item {
        display: flex;
        gap: 1rem;
        padding: 1rem 1.5rem;
        align-items: flex-start;
        border-bottom: 1px solid var(--ld-border-lt);
        transition: var(--ld-transition);
    }
    .ld-timeline-item:last-child { border-bottom: none; }
    .ld-timeline-item:hover { background: var(--ld-surface); }
    .ld-timeline-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: .9rem;
    }
    .ld-timeline-icon.success { background: var(--ld-emerald-xlt); color: var(--ld-emerald); }
    .ld-timeline-icon.info    { background: var(--ld-blue-xlt); color: var(--ld-blue); }
    .ld-timeline-icon.warning { background: var(--ld-orange-xlt); color: var(--ld-orange); }
    .ld-timeline-icon.danger  { background: var(--ld-red-xlt); color: var(--ld-red); }
    .ld-timeline-icon.purple  { background: var(--ld-violet-xlt); color: var(--ld-violet); }
    .ld-timeline-content { flex: 1; }
    .ld-timeline-msg {
        font-size: .875rem;
        color: var(--ld-text);
        line-height: 1.5;
        margin: 0;
    }
    .ld-timeline-msg strong { font-weight: 700; }
    .ld-timeline-time {
        font-size: .72rem;
        color: var(--ld-muted);
        margin-top: .2rem;
    }

    /* ══════════════════════════════════════════════════════════════
       FIFTH ROW — Department Chart
       ══════════════════════════════════════════════════════════════ */
    .ld-chart-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
        color: var(--ld-muted);
        font-size: .85rem;
        gap: .6rem;
    }
    .ld-chart-empty i { font-size: 2.5rem; opacity: .25; }

    /* ══════════════════════════════════════════════════════════════
       QUICK ACTIONS (BOTTOM)
       ══════════════════════════════════════════════════════════════ */
    .ld-actions-row {
        display: flex;
        gap: .85rem;
        flex-wrap: wrap;
    }
    .ld-action-btn {
        padding: .75rem 1.5rem;
        border-radius: var(--ld-radius-sm);
        font-size: .85rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: var(--ld-transition);
        color: #fff;
    }
    .ld-action-btn:hover {
        transform: translateY(-2px);
        box-shadow: var(--ld-shadow-md);
    }
    .ld-action-btn.blue   { background: linear-gradient(135deg, #2563EB, #1D4ED8); }
    .ld-action-btn.green  { background: linear-gradient(135deg, #10B981, #059669); }
    .ld-action-btn.violet { background: linear-gradient(135deg, #7C3AED, #6D28D9); }
    .ld-action-btn.orange { background: linear-gradient(135deg, #F59E0B, #D97706); color: #1C1917; }
    .ld-action-btn.slate  { background: linear-gradient(135deg, #475569, #334155); }

    /* ══════════════════════════════════════════════════════════════
       FLOATING ALERTS PANEL
