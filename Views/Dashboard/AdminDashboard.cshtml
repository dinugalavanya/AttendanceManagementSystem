@{
    Layout = null;
}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const openBtn = document.getElementById("openAddWorkerModal");
        const modal = document.getElementById("addWorkerModal");
        const closeBtn = document.getElementById("closeAddWorkerModal");
        const cancelBtn = document.getElementById("cancelAddWorkerModal");
        const form = document.getElementById("addWorkerForm");
        const messageBox = document.getElementById("addWorkerMessage");

        function showMessage(type, message) {
            if (!messageBox) return;

            messageBox.style.display = "block";
            messageBox.className = "add-worker-message " + type;
            messageBox.innerHTML = message;
        }

        function clearMessage() {
            if (!messageBox) return;

            messageBox.style.display = "none";
            messageBox.className = "add-worker-message";
            messageBox.innerHTML = "";
        }

        function openModal() {
            if (!modal) {
                console.error("Add Worker modal not found. Missing id='addWorkerModal'.");
                return;
            }

            clearMessage();
            modal.style.display = "flex";
            document.body.style.overflow = "hidden";
        }

        function closeModal() {
            if (!modal) return;

            modal.style.display = "none";
            document.body.style.overflow = "";

            if (form) {
                form.reset();
            }

            clearMessage();
        }

        if (!openBtn) {
            console.error("Add New Worker button not found. Missing id='openAddWorkerModal'.");
        } else {
            openBtn.addEventListener("click", function (event) {
                event.preventDefault();
                openModal();
            });
        }

        if (closeBtn) {
            closeBtn.addEventListener("click", closeModal);
        }

        if (cancelBtn) {
            cancelBtn.addEventListener("click", closeModal);
        }

        if (modal) {
            modal.addEventListener("click", function (event) {
                if (event.target === modal) {
                    closeModal();
                }
            });
        }

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && modal && modal.style.display === "flex") {
                closeModal();
            }
        });

        if (form) {
            form.addEventListener("submit", async function (event) {
                event.preventDefault();

                const serviceId = document.getElementById("workerServiceId")?.value?.trim();
                const email = document.getElementById("workerEmail")?.value?.trim();
                const phone = document.getElementById("workerPhone")?.value?.trim();
                const sectionId = document.getElementById("workerSectionId")?.value;

                if (!serviceId || !email || !phone || !sectionId) {
                    showMessage("error", "Please fill all required fields.");
                    return;
                }

                const token = document.querySelector('#addWorkerForm input[name="__RequestVerificationToken"]')?.value;

                try {
                    const response = await fetch("/Dashboard/CreateWorker", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": token || ""
                        },
                        body: JSON.stringify({
                            serviceId: serviceId,
                            email: email,
                            phone: phone,
                            sectionId: parseInt(sectionId)
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        showMessage("success", result.message || "Worker created successfully.");

                        setTimeout(function () {
                            closeModal();
                            window.location.reload();
                        }, 1000);
                    } else {
                        let errorText = result.message || "Failed to create worker.";

                        if (result.errors) {
                            errorText = Object.values(result.errors)
                                .flat()
                                .join("<br>");
                        }

                        showMessage("error", errorText);
                    }
                } catch (error) {
                    console.error(error);
                    showMessage("error", "Something went wrong while creating the worker.");
                }
            });
        }
    });

    function closeAttendanceModal() {
        const modal = document.getElementById("attendanceModal");

        if (!modal) return;

        modal.classList.remove("show");

        setTimeout(function () {
            modal.classList.add("hidden");
        }, 300);
    }
</script>
</body>
</html>
