            <h3>Add New Worker</h3>
            <button type="button" id="closeAddWorkerModal" class="modal-close-btn">&times;</button>
        </div>

        <form id="addWorkerForm">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="workerServiceId">Service ID</label>
                <input type="text" id="workerServiceId" name="serviceId" placeholder="Enter Service ID" required />
            </div>

            <div class="form-group">
                <label for="workerEmail">Email Address</label>
                <input type="email" id="workerEmail" name="email" placeholder="Enter Email Address" required />
            </div>

            <div class="form-group">
                <label for="workerPhone">Phone Number</label>
                <input type="tel" id="workerPhone" name="phone" placeholder="Enter Phone Number" required />
            </div>

            <div class="form-group">
                <label for="workerSectionId">Section</label>
                <select id="workerSectionId" name="sectionId" required>
                    <option value="">Select Section</option>
                    @if (ViewBag.Sections != null)
                    {
                        foreach (var section in ViewBag.Sections)
                        {
                            <option value="@(section.Id)">@(section.Name)</option>
                        }
                    }
                </select>
            </div>

            <div class="password-info-box">
                A temporary password will be securely generated.
            </div>

            <div id="addWorkerMessage" class="add-worker-message" style="display: none;"></div>

            <div class="modal-actions">
                <button type="button" id="cancelAddWorkerModal" class="btn-cancel">Cancel</button>
                <button type="submit" class="btn-create-worker">Create Worker</button>
            </div>
        </form>
    </div>
