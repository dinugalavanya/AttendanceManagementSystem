        }
    </style>

    <section class="dashboard-shell mt-5">
        <!-- Leave Agent Workspace Header -->
        <div class="la-workspace">
            <h1>OT Management Workspace</h1>
            <p>Manage overtime requests, approvals, and employee availability</p>
            <div class="la-workspace-badges">
                <span class="la-badge"><i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("MMMM yyyy")</span>
                <span class="la-badge"><i class="bi bi-people me-1"></i> @(Model.OTEmployees?.Count ?? 0) Employees</span>
                <span class="la-badge"><i class="bi bi-clock-history me-1"></i> @(Model.OTSummary?.TotalOTHours.ToString("0.0") ?? "0")h Total OT</span>
            </div>
        </div>

        <!-- Operational Summary Cards -->
        <div class="la-summary-cards">
            <div class="la-summary-card">
                <div class="la-summary-icon pending">
                    <i class="bi bi-clock"></i>
                </div>
                <div class="la-summary-value">@(Model.OTSummary?.Employees95to100 + Model.OTSummary?.EmployeesAbove100 ?? 0)</div>
                <div class="la-summary-label">Pending OT Requests</div>
            </div>
            <div class="la-summary-card">
                <div class="la-summary-icon today">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div class="la-summary-value">@(Model.TodayOTStatus?.EmployeesScheduledOT ?? 0)</div>
                <div class="la-summary-label">Today's OT</div>
            </div>
            <div class="la-summary-card">
                <div class="la-summary-icon conflict">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div class="la-summary-value">@(Model.OTSummary?.EmployeesAbove100 ?? 0)</div>
                <div class="la-summary-label">OT Conflicts</div>
            </div>
        </div>

        <!-- OT Queue with Search and Filters -->
        <div class="la-card">
            <div class="la-card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                <h5>OT Queue</h5>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <input type="text" class="la-search-bar" placeholder="Search employees..." id="otSearchInput">
                    <select class="la-filter-select" id="otFilterSelect">
                        <option value="all">All Departments</option>
                        <option value="IT">IT</option>
                        <option value="Engineering">Engineering</option>
                        <option value="Operations">Operations</option>
                    </select>
                    <select class="la-filter-select" id="otPercentageFilter">
                        <option value="all">All OT %</option>
                        <option value="70">70%</option>
                        <option value="80">80%</option>
                        <option value="100">100%</option>
                        <option value="above100">Above 100%</option>
                    </select>
                </div>
            </div>
            <div class="la-card-body">
                <div class="la-table-container">
                    <table class="la-table" id="otQueueTable">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Department</th>
                                <th>OT Date</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>OT Hours</th>
                                <th>Edit</th>
                            </tr>
                        </thead>
                        <tbody id="otQueueTableBody">
                            @if (Model.OTEmployees != null && Model.OTEmployees.Any())
                            {
                                foreach (var employee in Model.OTEmployees)
                                {
                                    <tr data-name="@($"{employee.FirstName} {employee.LastName}")" data-department="@employee.Department" data-ot-percentage="@employee.TotalOTHours">
                                        <td>
                                            <div class="la-employee-cell">
                                                <div class="la-avatar">@employee.Initials</div>
                                                <div class="la-employee-info">
                                                    <span class="la-employee-name">@employee.FirstName @employee.LastName</span>
                                                    <span class="la-employee-id">@employee.ServiceId</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@employee.Department</td>
                                        <td>@DateTime.Now.ToString("dd/MM/yyyy")</td>
                                        <td>18:00</td>
                                        <td>22:00</td>
                                        <td>@employee.TotalOTHours.ToString("0.0")h</td>
                                        <td>
                                            <button type="button" class="la-btn-edit" onclick="openEditModal('@employee.ServiceId', '@employee.FirstName', '@employee.LastName', '@employee.Department')">
                                                <i class="bi bi-pencil"></i> Edit
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div style="color: #9ca3af;">
                                            <i class="bi bi-inbox" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                                            <span>No OT requests found</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Monthly OT Calendar -->
        <div class="la-card">
            <div class="la-card-header d-flex justify-content-between align-items-center">
                <h5>Monthly OT Calendar - @Model.OTCurrentMonthLabel</h5>
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="changeOTMonth(-1)">
                        <i class="bi bi-chevron-left"></i> Previous
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="changeOTMonth(1)">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
            <div class="la-card-body">
                <!-- Calendar Legend -->
                <div class="d-flex gap-3 mb-3 flex-wrap">
                    <div class="d-flex align-items-center">
                        <span style="width: 12px; height: 12px; background: #dbeafe; border: 1px solid #93c5fd; border-radius: 3px; display: inline-block;"></span>
                        <small class="ms-1">Approved OT</small>
                    </div>
                    <div class="d-flex align-items-center">
                        <span style="width: 12px; height: 12px; background: #fef3c7; border: 1px solid #fcd34d; border-radius: 3px; display: inline-block;"></span>
                        <small class="ms-1">Pending OT</small>
                    </div>
                    <div class="d-flex align-items-center">
                        <span style="width: 12px; height: 12px; background: #fee2e2; border: 1px solid #fca5a5; border-radius: 3px; display: inline-block;"></span>
                        <small class="ms-1">OT Conflict</small>
                    </div>
                    <div class="d-flex align-items-center">
                        <span style="width: 12px; height: 12px; background: #d1fae5; border: 1px solid #6ee7b7; border-radius: 3px; display: inline-block;"></span>
                        <small class="ms-1">Holiday</small>
                    </div>
                </div>

                <!-- Calendar Grid -->
                <div class="la-calendar-header">
                    <div class="la-calendar-header-cell">Sun</div>
                    <div class="la-calendar-header-cell">Mon</div>
                    <div class="la-calendar-header-cell">Tue</div>
                    <div class="la-calendar-header-cell">Wed</div>
                    <div class="la-calendar-header-cell">Thu</div>
                    <div class="la-calendar-header-cell">Fri</div>
                    <div class="la-calendar-header-cell">Sat</div>
                </div>
                <div class="la-calendar-grid">
                    @if (Model.OTCalendarDays != null)
                    {
                        foreach (var day in Model.OTCalendarDays)
                        {
                            var dayClass = day.IsCurrentMonth ? "" : "opacity-50";
                            var statusClass = day.OTStatus switch
                            {
                                "approved" => "approved",
                                "pending" => "pending",
                                "conflict" => "conflict",
                                "holiday" => "holiday",
                                _ => ""
                            };
                            <div class="la-calendar-day @dayClass @statusClass @(day.IsToday ? "today" : "")"
                                 title="@day.EmployeesOnOT/@day.TotalEmployees on OT (@day.AverageOTAllocation.ToString("0.0")%)"
                                 onclick="loadOTDataForDate('@day.Year-@day.Month.ToString("00")-@day.Day.ToString("00")')">
                                <span class="la-calendar-day-number">@day.Day</span>
                                @if (day.IsCurrentMonth && day.EmployeesOnOT > 0)
                                {
                                    <span class="la-calendar-ot-count">@day.EmployeesOnOT</span>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Export OT Data -->
        <div class="la-card">
            <div class="la-card-body">
                <div class="la-export-section">
                    <div>
                        <h5 class="mb-1">Export OT Data</h5>
                        <p class="text-muted mb-0 small">Export OT records for selected date range to PDF.</p>
                    </div>
                    <div class="la-date-range">
                        <input type="date" class="la-date-input" id="exportFromDate" placeholder="From">
                        <span style="color: #9ca3af;">to</span>
                        <input type="date" class="la-date-input" id="exportToDate" placeholder="To">
                        <button type="button" class="la-btn-export" onclick="exportToPDF()">
                            <i class="bi bi-file-earmark-pdf"></i> Export PDF
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit OT Modal -->
        <div class="la-modal-overlay" id="editOTModal">
            <div class="la-modal">
                <div class="la-modal-header">
                    <h3>Edit OT Request</h3>
                    <button class="la-modal-close" onclick="closeEditModal()">&times;</button>
                </div>
                <div class="la-modal-body">
                    <form id="editOTForm">
                        <input type="hidden" id="editServiceId">
                        <div class="la-form-group">
                            <label class="la-form-label">Employee</label>
                            <input type="text" class="la-form-input" id="editEmployeeName" readonly>
                        </div>
                        <div class="la-form-group">
                            <label class="la-form-label">Department</label>
                            <input type="text" class="la-form-input" id="editDepartment" readonly>
                        </div>
                        <div class="la-form-group">
                            <label class="la-form-label">OT Date</label>
                            <input type="date" class="la-form-input" id="editOTDate">
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="la-form-group">
                                    <label class="la-form-label">Start Time</label>
                                    <input type="time" class="la-form-input" id="editStartTime">
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="la-form-group">
                                    <label class="la-form-label">End Time</label>
                                    <input type="time" class="la-form-input" id="editEndTime">
                                </div>
                            </div>
                        </div>
                        <div class="la-form-group">
                            <label class="la-form-label">OT Hours</label>
                            <input type="number" step="0.5" class="la-form-input" id="editOTHours">
                        </div>
                    </form>
                </div>
                <div class="la-modal-footer">
                    <button type="button" class="la-btn-secondary" onclick="closeEditModal()">Cancel</button>
                    <button type="button" class="la-btn-primary" onclick="saveOTRequest()">Save Changes</button>
                </div>
            </div>
        </div>
    </section>
}

@section Scripts {
    <script>
        // OT Calendar Navigation
        function changeOTMonth(delta) {
            // Placeholder for month navigation - would need AJAX call
            console.log("Change month by", delta);
        }

        function loadOTDataForDate(dateStr) {
            // Placeholder for loading date-specific data
            console.log("Load OT data for date:", dateStr);
        }

        // Edit OT Modal Functions
        function openEditModal(serviceId, firstName, lastName, department) {
            document.getElementById('editServiceId').value = serviceId;
            document.getElementById('editEmployeeName').value = firstName + ' ' + lastName;
            document.getElementById('editDepartment').value = department;
            document.getElementById('editOTDate').value = new Date().toISOString().split('T')[0];
            document.getElementById('editStartTime').value = '18:00';
            document.getElementById('editEndTime').value = '22:00';
            document.getElementById('editOTHours').value = '4.0';
            document.getElementById('editOTModal').classList.add('active');
        }

        function closeEditModal() {
            document.getElementById('editOTModal').classList.remove('active');
        }

        function saveOTRequest() {
            const serviceId = document.getElementById('editServiceId').value;
            const otDate = document.getElementById('editOTDate').value;
            const startTime = document.getElementById('editStartTime').value;
            const endTime = document.getElementById('editEndTime').value;
            const otHours = document.getElementById('editOTHours').value;
            
            console.log('Saving OT request:', { serviceId, otDate, startTime, endTime, otHours });
            // Placeholder for AJAX call to save OT request
            closeEditModal();
        }

        // Export OT Data
        function exportOTData() {
            // Placeholder for exporting OT data to Excel
            console.log("Export OT data to Excel");
        }

        // Export to PDF
        function exportToPDF() {
            const fromDate = document.getElementById('exportFromDate').value;
            const toDate = document.getElementById('exportToDate').value;
            console.log('Export to PDF:', { fromDate, toDate });
            // Placeholder for PDF export functionality
            alert('PDF export functionality will be implemented with the selected date range.');
        }

        // Search and Filter Functionality
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('otSearchInput');
            const filterSelect = document.getElementById('otFilterSelect');
            const otPercentageFilter = document.getElementById('otPercentageFilter');
            const tableBody = document.getElementById('otQueueTableBody');
            
            if (searchInput && tableBody) {
                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    filterTable(searchTerm, filterSelect ? filterSelect.value : 'all', otPercentageFilter ? otPercentageFilter.value : 'all');
                });
            }
            
            if (filterSelect && tableBody) {
                filterSelect.addEventListener('change', function() {
                    const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
                    filterTable(searchTerm, this.value, otPercentageFilter ? otPercentageFilter.value : 'all');
                });
            }
            
            if (otPercentageFilter && tableBody) {
                otPercentageFilter.addEventListener('change', function() {
                    const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
                    filterTable(searchTerm, filterSelect ? filterSelect.value : 'all', this.value);
                });
            }
            
            function filterTable(searchTerm, departmentFilter, otPercentageFilter) {
                const rows = tableBody.querySelectorAll('tr');
                
                rows.forEach(row => {
                    const name = row.dataset.name?.toLowerCase() || '';
                    const department = row.dataset.department?.toLowerCase() || '';
                    const otPercentage = parseFloat(row.dataset.otPercentage) || 0;
                    
                    const matchesSearch = name.includes(searchTerm) || department.includes(searchTerm);
                    const matchesDepartment = departmentFilter === 'all' || department === departmentFilter.toLowerCase();
                    
                    let matchesOTPercentage = true;
                    if (otPercentageFilter !== 'all') {
                        if (otPercentageFilter === 'above100') {
                            matchesOTPercentage = otPercentage > 100;
                        } else {
                            const threshold = parseFloat(otPercentageFilter);
                            matchesOTPercentage = otPercentage >= threshold;
                        }
                    }
                    
                    row.style.display = matchesSearch && matchesDepartment && matchesOTPercentage ? '' : 'none';
                });
            }
            
            // Close modal when clicking outside
            const modalOverlay = document.getElementById('editOTModal');
            if (modalOverlay) {
                modalOverlay.addEventListener('click', function(e) {
                    if (e.target === modalOverlay) {
                        closeEditModal();
                    }
                });
            }
        });
    </script>
}
