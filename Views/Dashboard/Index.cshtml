        .la-calendar-day.pending { background: #fef3c7; border-color: #fcd34d; }
        .la-calendar-day.conflict { background: #fee2e2; border-color: #fca5a5; }
        .la-calendar-day.holiday { background: #d1fae5; border-color: #6ee7b7; }
        .la-calendar-day-number {
            font-weight: 600;
            font-size: 0.875rem;
            color: #1f2937;
        }
        .la-calendar-ot-count {
