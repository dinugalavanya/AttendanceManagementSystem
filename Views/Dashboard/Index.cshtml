@model DashboardViewModel
@using System.Text.Json
@using AttendanceManagementSystem.Models
@{
    ViewData["Title"] = "Dashboard";

    var roleLabel = Model.IsSuperAdmin ? "SuperAdmin" : Model.IsAdmin ? "Admin" : "Worker";
    var roleTone = Model.IsSuperAdmin ? "super" : Model.IsAdmin ? "admin" : "worker";
    var attendanceRate = Model.AttendanceTargetPercent;
    var monthlyLeaveCount = Model.DistributionValues.Count > 3 ? Model.DistributionValues[3] : 0;
    var currentMonthLabel = Model.SelectedDate.ToString("MMMM yyyy");

    var header = new PageHeaderViewModel
    {
        Eyebrow = "People Operations",
        Title = Model.IsWorker ? "My OT Dashboard" : "OT Command Center",
        Subtitle = Model.ScopeTitle,
        Badges = new List<PageHeaderBadgeViewModel>
        {
            new() { Text = roleLabel, Tone = roleTone, Icon = "bi-person-badge" },
            new() { Text = currentMonthLabel, Tone = "neutral", Icon = "bi-calendar3" }
        }
    };

    var cards = new List<SummaryCardViewModel>();
    var selectedDateLabel = Model.SelectedDate == DateTime.Today ? "Today" : Model.SelectedDate.ToString("MMM dd");
    
    // Only keep OT Hours card for workers
    if (Model.IsWorker)
    {
        cards.AddRange(new List<SummaryCardViewModel>
        {
            new() { Label = "OT Hours This Month", Value = Math.Round(Model.OvertimeMinutesMonth / 60m, 1).ToString("0.0"), Icon = "bi-hourglass-split", Tone = "purple", HelperText = "Overtime logged this month" }
        });
    }
    else
    {
        // Keep only essential cards for admins
        cards.AddRange(new List<SummaryCardViewModel>
        {
            new() { Label = "OT Records This Month", Value = Model.MonthlyPresentCount.ToString(), Icon = "bi-check2-circle", Tone = "success", HelperText = "Recorded OT entries this month" },
            new() { Label = "OT Hours This Month", Value = Math.Round(Model.OvertimeMinutesMonth / 60m, 1).ToString("0.0"), Icon = "bi-hourglass-split", Tone = "purple", HelperText = "Total overtime this month" }
        });
    }

    var dailyStatusPanel = new ChartPanelViewModel
    {
        Title = "Daily OT Trend",
        Subtitle = "Bars for OT record volumes plus line for OT hours",
        Meta = "Combined chart",
        CanvasId = "statusBarChart"
    };

    var noSectionData = new EmptyStateViewModel
    {
        Icon = "bi-diagram-3",
        Title = "No section activity found",
        Description = "Section-level OT data is not available for the selected scope today."
    };
    var noActivityData = new EmptyStateViewModel
    {
        Icon = "bi-clock-history",
        Title = "No recent activity yet",
        Description = "Recent OT activity will appear here once entries are captured."
    };

}

<section class="dashboard-shell">
    <!-- Premium Hero Section -->
    <div class="dashboard-hero">
        <div class="dashboard-hero-content">
            <div class="dashboard-hero-text">
                <h1>@(DateTime.Now.Hour < 12 ? "Good Morning" : DateTime.Now.Hour < 17 ? "Good Afternoon" : "Good Evening"), @(User.Identity?.Name?.Split(' ')[0] ?? "User") 👋</h1>
                <p>Here's your OT overview and performance summary.</p>
            </div>
            <div class="dashboard-hero-illustration">
                <i class="bi bi-graph-up"></i>
            </div>
        </div>
    </div>

    <partial name="_PageHeader" model="header" />

    <!-- Date Filter Form -->
    <form method="get" asp-action="Index" class="dashboard-date-filter mb-4">
        <div class="row align-items-center">
            <div class="col-auto">
                <label for="selectedDate" class="form-label mb-0 fw-semibold">View OT Dashboard Date:</label>
            </div>
            <div class="col-auto">
                <input type="date"
                       id="selectedDate"
                       name="selectedDate"
                       class="form-control"
                       value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()" />
            </div>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.WorkerSearchMessage))
    {
        <div class="alert alert-info mt-3">
            @Model.WorkerSearchMessage
        </div>
    }

    @if (Model.WorkerHistorySearchResult != null)
    {
        var worker = Model.WorkerHistorySearchResult;

        <div class="card mt-3 shadow-sm border-0">
            <div class="card-header bg-white">
                <h5 class="mb-0">Worker OT History</h5>
                <small>Service ID / Service Number: @worker.ServiceId</small>
            </div>

            <div class="card-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-2">
                        <strong>Worker ID</strong>
                        <div>@worker.WorkerId</div>
                    </div>
                    <div class="col-md-3">
                        <strong>Name</strong>
                        <div>@worker.FullName</div>
                    </div>
                    <div class="col-md-3">
                        <strong>Email</strong>
                        <div>@worker.Email</div>
                    </div>
                    <div class="col-md-2">
                        <strong>Section</strong>
                        <div>@worker.SectionName</div>
                    </div>
                    <div class="col-md-1">
                        <strong>Worked</strong>
                        <div>@worker.TotalWorkedHours h</div>
                    </div>
                    <div class="col-md-1">
                        <strong>OT</strong>
                        <div>@worker.TotalOTHours h</div>
                    </div>
                </div>

                @if (worker.History.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                        <th>OT In Time</th>
                                    <th>OT Out Time</th>
                                    <th>OT Duration</th>
                                    <th>OT Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in worker.History)
                                {
                                    <tr>
                                        <td>@row.Date.ToString("dd MMM yyyy")</td>
                                        <td>@row.InTime</td>
                                        <td>@row.OutTime</td>
                                        <td>@row.WorkedHours</td>
                                        <td>@row.OTHours</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.IsWorker)
    {
        <section class="ot-hours-card mb-4">
            <div class="ot-card-content">
                <div class="ot-card-left">
                    <div class="ot-icon-badge">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div class="ot-mini-stat">
                        <div class="ot-mini-label">This Month OT</div>
                        <div class="ot-mini-value">@Math.Round(Model.OvertimeMinutesMonth / 60m, 1).ToString("0.0") hrs</div>
                    </div>
                </div>
                <div class="ot-card-right">
                    <div class="ot-card-header">
                        <h2 class="ot-card-title">OT Hours Trend</h2>
                        <p class="ot-card-subtitle">Daily trend of overtime hours</p>
                    </div>
                    <div class="ot-card-body">
                        <div class="ot-chart-container">
                            <canvas id="otHoursChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="premium-summary-grid">
            @foreach (var card in cards)
            {
                <div class="premium-card @(card.Tone == "success" ? "success" : card.Tone == "purple" ? "purple" : "")">
                    <div class="premium-card-body">
                        <div class="premium-icon-wrapper @(card.Tone == "success" ? "success" : card.Tone == "purple" ? "purple" : "")">
                            <i class="bi @card.Icon"></i>
                        </div>
                        <div class="premium-content">
                            <div class="premium-label">@card.Label</div>
                            <div class="premium-value">@card.Value</div>
                            <div class="premium-helper">@card.HelperText</div>
                        </div>
                    </div>
                </div>
            }
        </section>
    }

    @if (!Model.IsWorker)
    {
        <section class="dashboard-analytics-grid">
            <div class="analytics-main">
                <div class="premium-chart-panel">
                    <div class="premium-chart-header">
                        <h2 class="premium-chart-title">Monthly OT Trend</h2>
                        <p class="premium-chart-subtitle">Daily movement of OT records and OT hours</p>
                    </div>
                    <div class="premium-chart-body">
                        <div class="premium-chart-container">
                            <canvas id="attendanceTrendChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <aside class="analytics-side">
                <div class="premium-chart-panel">
                    <div class="premium-chart-header">
                        <h2 class="premium-chart-title">Monthly Progress</h2>
                        <p class="premium-chart-subtitle">Working-day performance and attendance reliability</p>
                        <span class="panel-meta">@currentMonthLabel</span>
                    </div>
                    <div class="premium-chart-body">
                        <div class="progress-hero">
                            <div>
                                <p class="tiny-label">OT Coverage</p>
                                <h3 class="metric-large">@attendanceRate.ToString("0.0")%</h3>
                            </div>
                            <div>
                                <p class="tiny-label">OT Hours</p>
                                <h3 class="metric-large">@Math.Round(Model.OvertimeMinutesMonth / 60m, 1).ToString("0.0")h</h3>
                            </div>
                        </div>
                        <div class="premium-progress" role="progressbar" aria-label="Monthly OT coverage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@attendanceRate">
                            <div class="premium-progress-bar" style="width:@attendanceRate%;"></div>
                        </div>

                        <div class="mini-stats-grid">
                            <div class="mini-stat">
                                <p class="mini-stats-label">Working Days</p>
                                <h4>@Model.WorkingDaysToDate</h4>
                            </div>
                            <div class="mini-stat">
                                <p class="mini-stats-label">OT Days</p>
                                <h4>@Model.AttendedDaysToDate</h4>
                            </div>
                            <div class="mini-stat">
                                <p class="mini-stats-label">OT Records</p>
                                <h4>@Model.MonthlyPresentCount</h4>
                            </div>
                            <div class="mini-stat">
                                <p class="mini-stats-label">Review</p>
                                <h4>@Model.MonthlyLateCount</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>
        </section>

        <section class="dashboard-charts-grid">
            <div class="premium-chart-panel">
                <div class="premium-chart-header">
                    <h2 class="premium-chart-title">@dailyStatusPanel.Title</h2>
                    <p class="premium-chart-subtitle">@dailyStatusPanel.Subtitle</p>
                </div>
                <div class="premium-chart-body">
                    <div class="premium-chart-container">
                        <canvas id="@dailyStatusPanel.CanvasId"></canvas>
                    </div>
                </div>
            </div>
            <div class="premium-chart-panel">
                <div class="premium-chart-header">
                    <h2 class="premium-chart-title">OT Distribution</h2>
                    <p class="premium-chart-subtitle">OT record split for the current month</p>
                </div>
                <div class="premium-chart-body">
                    <div class="premium-chart-container">
                        <canvas id="distributionChart"></canvas>
                    </div>
                </div>
            </div>
        </section>
    }

    <section class="dashboard-insights-grid">
        @if (!Model.IsWorker)
        {
            <article class="panel-card">
                <header class="panel-header">
                    <div>
                        <h2>Section OT Summary</h2>
                        <p class="panel-subtitle">Today by section with OT record totals</p>
                    </div>
                </header>
                <div class="panel-body">
                    @if (Model.SectionSnapshots.Any())
                    {
                        <div class="table-responsive insight-table-wrap">
                            <table class="table table-modern mb-0">
                                <thead>
                                    <tr>
                                        <th>Section</th>
                                        <th>OT Records</th>
                                        <th>Review</th>
                                        <th>No OT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.SectionSnapshots)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.SectionName</td>
                                            <td><span class="badge-soft badge-soft-success">@item.PresentCount</span></td>
                                            <td><span class="badge-soft badge-soft-warning">@item.LateCount</span></td>
                                            <td><span class="badge-soft badge-soft-danger">@item.AbsentCount</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <partial name="_EmptyState" model="noSectionData" />
                    }
                </div>
            </article>
        }

        <article class="panel-card">
            <header class="panel-header">
                <div>
                    <h2>@(Model.IsWorker ? "My Recent OT Activity" : "Recent OT Activity")</h2>
                    <p class="panel-subtitle">Most recent OT updates from today's records</p>
                </div>
            </header>
            <div class="panel-body">
                @if (Model.RecentAttendance.Any())
                {
                    <div class="premium-activity-list">
                        @foreach (var item in Model.RecentAttendance)
                        {
                            var statusBadge = new StatusBadgeViewModel { Status = "Recorded OT", Tone = "success" };

                            <div class="premium-activity-item">
                                <div class="premium-activity-info">
                                    <h4>@item.EmployeeName</h4>
                                    <p>Section: @(item.SectionName ?? "N/A") | In: @(item.InTime?.ToString(@"hh\:mm") ?? "-") | Out: @(item.OutTime?.ToString(@"hh\:mm") ?? "-")</p>
                                </div>
                                <span class="premium-status-badge @statusBadge.Tone">@statusBadge.Status</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <partial name="_EmptyState" model="noActivityData" />
                }
            </div>
        </article>
    </section>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const labels = @Html.Raw(JsonSerializer.Serialize(Model.TrendLabels));
        const presentData = @Html.Raw(JsonSerializer.Serialize(Model.PresentTrend));
        const lateData = @Html.Raw(JsonSerializer.Serialize(Model.LateTrend));
        const absentData = @Html.Raw(JsonSerializer.Serialize(Model.AbsentTrend));
        const overtimeData = @Html.Raw(JsonSerializer.Serialize(Model.OvertimeTrendHours));
        const distributionLabels = @Html.Raw(JsonSerializer.Serialize(Model.DistributionLabels));
        const distributionValues = @Html.Raw(JsonSerializer.Serialize(Model.DistributionValues));

        const commonGridColor = "rgba(95, 122, 160, 0.18)";
        const commonTickColor = "#5f6f87";
        const commonLegend = {
            position: "bottom",
            labels: {
                usePointStyle: true,
                pointStyle: "circle",
                boxWidth: 10,
                color: "#34415a",
                font: {
                    family: "Public Sans",
                    size: 12
                }
            }
        };

        const commonScales = {
            x: {
                ticks: { color: commonTickColor, maxRotation: 0, autoSkipPadding: 18 },
                grid: { display: false }
            },
            y: {
                beginAtZero: true,
                ticks: { precision: 0, color: commonTickColor },
                grid: { color: commonGridColor }
            }
        };

        // OT Hours Chart for Workers - Only shows OT data
        const otHoursElement = document.getElementById("otHoursChart");
        if (otHoursElement) {
            new Chart(otHoursElement, {
                type: "line",
                data: {
                    labels,
                    datasets: [
                        {
                            label: "OT Hours",
                            data: overtimeData,
                            borderColor: "#8b5cf6",
                            backgroundColor: "rgba(139, 92, 246, 0.1)",
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: "#8b5cf6",
                            pointBorderColor: "#fff",
                            pointBorderWidth: 2,
                            fill: true,
                            tension: 0.4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: "#10233f",
                            titleFont: { family: "Outfit" },
                            bodyFont: { family: "Public Sans" },
                            callbacks: {
                                label: function(context) {
                                    return `OT Hours: ${context.parsed.y.toFixed(1)} hrs`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: commonTickColor, maxRotation: 0, autoSkipPadding: 18 },
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: { 
                                precision: 1, 
                                color: commonTickColor,
                                callback: function(value) {
                                    return value.toFixed(1) + 'h';
                                }
                            },
                            grid: { color: commonGridColor }
                        }
                    }
                }
            });
        }

        // Admin-only charts
        const trendElement = document.getElementById("attendanceTrendChart");
        if (trendElement) {
            new Chart(trendElement, {
                type: "line",
                data: {
                    labels,
                    datasets: [
                        {
                            label: "OT Records",
                            data: presentData,
                            borderColor: "#0b9967",
                            backgroundColor: "rgba(11, 153, 103, 0.14)",
                            pointRadius: 2,
                            pointHoverRadius: 4,
                            fill: true,
                            tension: 0.34
                        },
                        {
                            label: "Review",
                            data: lateData,
                            borderColor: "#d08910",
                            backgroundColor: "rgba(208, 137, 16, 0.08)",
                            pointRadius: 2,
                            pointHoverRadius: 4,
                            fill: false,
                            tension: 0.32
                        },
                        {
                            label: "No OT",
                            data: absentData,
                            borderColor: "#cd3246",
                            backgroundColor: "rgba(205, 50, 70, 0.09)",
                            pointRadius: 2,
                            pointHoverRadius: 4,
                            fill: false,
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    plugins: {
                        legend: commonLegend,
                        tooltip: {
                            backgroundColor: "#10233f",
                            titleFont: { family: "Outfit" },
                            bodyFont: { family: "Public Sans" }
                        }
                    },
                    scales: commonScales
                }
            });
        }

        const statusElement = document.getElementById("statusBarChart");
        if (statusElement) {
            new Chart(statusElement, {
                data: {
                    labels,
                    datasets: [
                        {
                            type: "bar",
                            label: "OT Records",
                            data: presentData,
                            backgroundColor: "rgba(11, 153, 103, 0.82)",
                            borderRadius: 8
                        },
                        {
                            type: "bar",
                            label: "Review",
                            data: lateData,
                            backgroundColor: "rgba(208, 137, 16, 0.78)",
                            borderRadius: 8
                        },
                        {
                            type: "bar",
                            label: "No OT",
                            data: absentData,
                            backgroundColor: "rgba(205, 50, 70, 0.78)",
                            borderRadius: 8
                        },
                        {
                            type: "line",
                            label: "OT Hours",
                            data: overtimeData,
                            borderColor: "#275fd0",
                            backgroundColor: "rgba(39, 95, 208, 0.10)",
                            yAxisID: "y1",
                            pointRadius: 2,
                            pointHoverRadius: 4,
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    plugins: {
                        legend: commonLegend
                    },
                    scales: {
                        ...commonScales,
                        y1: {
                            beginAtZero: true,
                            position: "right",
                            grid: { drawOnChartArea: false },
                            ticks: { precision: 0, color: commonTickColor }
                        }
                    }
                }
            });
        }

        const distributionElement = document.getElementById("distributionChart");
        if (distributionElement) {
            new Chart(distributionElement, {
                type: "doughnut",
                data: {
                    labels: distributionLabels,
                    datasets: [
                        {
                            data: distributionValues,
                            borderWidth: 0,
                            backgroundColor: ["#0b9967", "#d08910", "#cd3246", "#6e7f99"],
                            hoverOffset: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "65%",
                    plugins: {
                        legend: commonLegend
                    }
                }
            });
        }
    </script>
}
