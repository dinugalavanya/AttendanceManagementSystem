@{
    ViewData["Title"] = "Loading Dashboard";
}

<style>
    /* Loading Page Styles */
    .loading-shell {
        position: fixed;
        inset: 0;
        background: linear-gradient(135deg, #f8fafc 0%, #f0f9ff 50%, #f0fdf4 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        overflow: hidden;
    }

    .loading-shell::before {
        content: '';
        position: absolute;
        inset: 0;
        background: 
            radial-gradient(circle at 20% 50%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
            radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.08) 0%, transparent 50%);
        pointer-events: none;
    }

    .loading-container {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 500px;
        padding: 2rem;
    }

    /* Animated Logo */
    .loading-logo {
        width: 120px;
        height: 120px;
        margin: 0 auto 2rem;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: white;
        box-shadow: 0 20px 40px rgba(99, 102, 241, 0.3);
        animation: logoFloat 3s ease-in-out infinite;
        position: relative;
        overflow: hidden;
    }

    .loading-logo::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.1) 50%, transparent 70%);
        animation: shimmer 2s infinite;
    }

    @@keyframes logoFloat {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
    }

    @@keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }

    /* Loading Title */
    .loading-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 0.5rem;
        font-family: "Outfit", sans-serif;
        letter-spacing: -0.02em;
    }

    .loading-subtitle {
        font-size: 1rem;
        color: #64748b;
        margin-bottom: 2rem;
        font-family: "Public Sans", sans-serif;
    }

    /* Animated Spinner */
    .loading-spinner {
        width: 50px;
        height: 50px;
        margin: 0 auto 2rem;
        position: relative;
    }

    .spinner-ring {
        position: absolute;
        width: 100%;
        height: 100%;
        border: 4px solid rgba(99, 102, 241, 0.1);
        border-top-color: #6366f1;
        border-right-color: #8b5cf6;
        border-radius: 50%;
        animation: spin 1.2s linear infinite;
    }

    .spinner-ring:nth-child(2) {
        width: 70%;
        height: 70%;
        top: 15%;
        left: 15%;
        border-top-color: #8b5cf6;
        border-right-color: transparent;
        animation: spin 1.8s linear infinite reverse;
    }

    .spinner-ring:nth-child(3) {
        width: 40%;
        height: 40%;
        top: 30%;
        left: 30%;
        border-top-color: #6366f1;
        border-right-color: #8b5cf6;
        animation: spin 2.4s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* Loading Steps */
    .loading-steps {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2rem;
    }

    .loading-step {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(99, 102, 241, 0.1);
        border-radius: 12px;
        backdrop-filter: blur(10px);
        animation: slideIn 0.5s ease-out forwards;
        opacity: 0;
    }

    .loading-step:nth-child(1) { animation-delay: 0.2s; }
    .loading-step:nth-child(2) { animation-delay: 0.4s; }
    .loading-step:nth-child(3) { animation-delay: 0.6s; }
    .loading-step:nth-child(4) { animation-delay: 0.8s; }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .step-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        color: white;
        flex-shrink: 0;
        position: relative;
    }

    .step-icon.pending {
        background: rgba(99, 102, 241, 0.2);
        color: #6366f1;
        border: 2px solid #6366f1;
    }

    .step-icon.active {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        animation: pulse 1.5s ease-in-out infinite;
    }

    .step-icon.completed {
        background: #10b981;
    }

    @@keyframes pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.7); }
        50% { box-shadow: 0 0 0 8px rgba(99, 102, 241, 0); }
    }

    .step-text {
        font-size: 0.875rem;
        color: #475569;
        font-weight: 500;
    }

    .step-text.active {
        color: #0f172a;
        font-weight: 600;
    }

    /* Progress Bar */
    .loading-progress {
        width: 100%;
        height: 4px;
        background: rgba(99, 102, 241, 0.1);
        border-radius: 999px;
        overflow: hidden;
        margin-top: 2rem;
    }

    .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        border-radius: 999px;
        animation: progress 2s ease-in-out infinite;
    }

    @@keyframes progress {
        0% { width: 0%; }
        50% { width: 70%; }
        100% { width: 100%; }
    }

    /* Loading Tips */
    .loading-tips {
        margin-top: 2rem;
        padding: 1rem;
        background: rgba(99, 102, 241, 0.05);
        border-left: 4px solid #6366f1;
        border-radius: 8px;
    }

    .loading-tip-title {
        font-size: 0.75rem;
        font-weight: 700;
        color: #6366f1;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .loading-tip-text {
        font-size: 0.875rem;
        color: #475569;
        line-height: 1.5;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .loading-container {
            padding: 1.5rem;
        }

        .loading-logo {
            width: 100px;
            height: 100px;
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
        }

        .loading-title {
            font-size: 1.5rem;
        }

        .loading-subtitle {
            font-size: 0.9rem;
        }

        .loading-steps {
            gap: 0.75rem;
        }

        .loading-step {
            padding: 0.6rem 0.8rem;
        }

        .step-text {
            font-size: 0.8rem;
        }
    }

    /* Hide scrollbar during loading */
    body.loading-active {
        overflow: hidden;
    }
</style>

<div class="loading-shell" id="loadingPage">
    <div class="loading-container">
        <!-- Animated Logo -->
        <div class="loading-logo">
            <i class="bi bi-graph-up"></i>
        </div>

        <!-- Title -->
        <h1 class="loading-title">Loading Dashboard</h1>
        <p class="loading-subtitle">Preparing your OT management overview...</p>

        <!-- Spinner -->
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <div class="spinner-ring"></div>
            <div class="spinner-ring"></div>
        </div>

        <!-- Loading Steps -->
        <div class="loading-steps">
            <div class="loading-step" id="step-1">
                <div class="step-icon pending" id="step-1-icon">1</div>
                <span class="step-text">Fetching employee data</span>
            </div>
            <div class="loading-step" id="step-2">
                <div class="step-icon pending" id="step-2-icon">2</div>
                <span class="step-text">Calculating OT allocations</span>
            </div>
            <div class="loading-step" id="step-3">
                <div class="step-icon pending" id="step-3-icon">3</div>
                <span class="step-text">Generating charts & reports</span>
            </div>
            <div class="loading-step" id="step-4">
                <div class="step-icon pending" id="step-4-icon">4</div>
                <span class="step-text">Finalizing dashboard</span>
            </div>
        </div>

        <!-- Progress Bar -->
        <div class="loading-progress">
            <div class="progress-bar"></div>
        </div>

        <!-- Loading Tips -->
        <div class="loading-tips">
            <div class="loading-tip-title">💡 Tip</div>
            <div class="loading-tip-text" id="loadingTip">
                The OT dashboard processes real-time data from all employees. This ensures you always have the most accurate allocation information.
            </div>
        </div>
    </div>
</div>

<script>
    // Simulate loading steps
    const steps = [
        { id: 'step-1', duration: 800, tip: '💡 Tip: OT allocations are calculated based on monthly working hours.' },
        { id: 'step-2', duration: 1600, tip: '💡 Tip: Use filters to quickly find employees in specific OT ranges.' },
        { id: 'step-3', duration: 2400, tip: '💡 Tip: Charts update automatically when you change filters.' },
        { id: 'step-4', duration: 3200, tip: '💡 Tip: Export reports as PDF for record-keeping and analysis.' }
    ];

    function updateStep(stepIndex) {
        if (stepIndex < steps.length) {
            const step = steps[stepIndex];
            const stepEl = document.getElementById(step.id);
            const iconEl = document.getElementById(step.id + '-icon');
            const textEl = stepEl.querySelector('.step-text');

            // Mark as active
            iconEl.classList.remove('pending');
            iconEl.classList.add('active');
            textEl.classList.add('active');

            // Update tip
            document.getElementById('loadingTip').textContent = step.tip;

            // Schedule next step
            setTimeout(() => {
                iconEl.classList.remove('active');
                iconEl.classList.add('completed');
                iconEl.innerHTML = '✓';
                textEl.classList.remove('active');

                if (stepIndex < steps.length - 1) {
                    updateStep(stepIndex + 1);
                } else {
                    // All steps complete - hide loading page
                    setTimeout(() => {
                        hideLoadingPage();
                    }, 500);
                }
            }, 600);
        }
    }

    function hideLoadingPage() {
        const loadingPage = document.getElementById('loadingPage');
        if (loadingPage) {
            loadingPage.style.animation = 'fadeOut 0.5s ease-out forwards';
            setTimeout(() => {
                loadingPage.style.display = 'none';
                document.body.classList.remove('loading-active');
            }, 500);
        }
    }

    // Add fade-out animation
    const style = document.createElement('style');
    style.textContent = `
        @@keyframes fadeOut {
            from { opacity: 1; }
            to { opacity: 0; }
        }
    `;
    document.head.appendChild(style);

    // Start loading sequence when page loads
    document.addEventListener('DOMContentLoaded', () => {
        document.body.classList.add('loading-active');
        updateStep(0);
    });

    // Alternative: Hide loading page when all content is loaded
    window.addEventListener('load', () => {
        setTimeout(() => {
            hideLoadingPage();
        }, 4000); // Ensure at least 4 seconds of loading animation
    });
</script>
