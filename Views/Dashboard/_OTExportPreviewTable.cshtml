@model List<AttendanceManagementSystem.ViewModels.OTEmployeeViewModel>
@{
    var fromDate = ViewData["FromDate"] as DateTime?;
    var toDate = ViewData["ToDate"] as DateTime?;
}

<div class="la-card-body p-0">
    <div class="la-table-container">
        <table class="la-table">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Date Range</th>
                    <th>OT Hours</th>
                    <th>OT Allocation %</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var emp in Model)
                    {
                        var statusBadgeClass = emp.OTAllocationPercentage switch
                        {
                            <= 75 => "badge bg-success",
                            <= 80 => "badge bg-info",
                            <= 95 => "badge bg-warning text-dark",
                            <= 100 => "badge bg-primary",
                            _ => "badge bg-danger"
                        };
                        <tr>
                            <td>
                                <div class="la-employee-cell">
                                    <div class="la-avatar">@emp.Initials</div>
                                    <div class="la-employee-info">
                                        <span class="la-employee-name">@emp.FirstName @emp.LastName</span>
                                        <span class="la-employee-id">@emp.ServiceId</span>
                                    </div>
                                </div>
                            </td>
                            <td>@emp.Department</td>
                            <td>@(fromDate?.ToString("dd/MM/yyyy") ?? "-") to @(toDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@emp.TotalOTHours.ToString("0.0")h</td>
                            <td><strong>@emp.OTAllocationPercentage.ToString("0.0")%</strong></td>
                            <td>
                                <span class="@statusBadgeClass" style="font-size: 0.8rem; padding: 0.4em 0.8em; border-radius: 4px; display: inline-block;">
                                    @emp.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div style="color: #9ca3af;">
                                <i class="bi bi-inbox" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                                <span>No OT records found matching the criteria</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
