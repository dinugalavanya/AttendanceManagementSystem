@model AttendanceManagementSystem.ViewModels.AttendanceHistoryViewModel
@{
    ViewData["Title"] = "My OT History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>My OT History
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Single Date Picker -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <form method="get" class="d-flex align-items-end gap-2">
                                <div class="flex-grow-1">
                                    <label for="selectedDate" class="form-label">Select Date</label>
                                    <input type="date" id="selectedDate" name="selectedDate" class="form-control"
                                           value="@(Model.SelectedDate?.ToString("yyyy-MM-dd") ?? "")">
                                </div>
                                <div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-calendar-check me-1"></i>View
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Selected Day Summary Card -->
                    @if (Model.SelectedDate.HasValue)
                    {
                        if (Model.SelectedDateRecord != null)
                        {
                            <div class="daily-record-card">
                                <div class="daily-record-header">
                                    <h5 class="daily-record-title">OT Record for @Model.SelectedDate.Value.ToString("dd MMM yyyy")</h5>
                                </div>
                                <div class="daily-record-content">
                                    <div class="info-boxes-row">
                                        <div class="info-box">
                                            <div class="info-icon-tile info-icon-tile-blue">
                                                <i class="bi bi-clock-fill"></i>
                                            </div>
                                            <div class="info-content">
                                                <div class="info-box-label">OT In Time</div>
                                                <div class="info-box-value">
                                                    @(Model.SelectedDateRecord.InTime.HasValue ? Model.SelectedDateRecord.InTime.Value.ToString(@"hh\:mm") : "-")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="info-box">
                                            <div class="info-icon-tile info-icon-tile-green">
                                                <i class="bi bi-arrow-right-circle-fill"></i>
                                            </div>
                                            <div class="info-content">
                                                <div class="info-box-label">OT Out Time</div>
                                                <div class="info-box-value">
                                                    @(Model.SelectedDateRecord.OutTime.HasValue ? Model.SelectedDateRecord.OutTime.Value.ToString(@"hh\:mm") : "-")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="info-box">
                                            <div class="info-icon-tile info-icon-tile-purple">
                                                <i class="bi bi-stopwatch-fill"></i>
                                            </div>
                                            <div class="info-content">
                                                <div class="info-box-label">OT Hours</div>
                                                <div class="info-box-value info-value-ot">
                                                    @{
                                                        int otMinutes = 0;
                                                        if (Model.SelectedDateRecord.InTime.HasValue && Model.SelectedDateRecord.OutTime.HasValue)
                                                        {
                                                            var inDateTime = Model.SelectedDateRecord.AttendanceDate.Date + Model.SelectedDateRecord.InTime.Value;
                                                            var outDateTime = Model.SelectedDateRecord.AttendanceDate.Date + Model.SelectedDateRecord.OutTime.Value;
                                                            if (outDateTime < inDateTime) outDateTime = outDateTime.AddDays(1);
                                                            otMinutes = (int)(outDateTime - inDateTime).TotalMinutes;
                                                        }
                                                    }
                                                    @(otMinutes > 0 ? $"{otMinutes / 60:D2}:{otMinutes % 60:D2}" : "0h 0m")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="info-box">
                                            <div class="info-icon-tile info-icon-tile-orange">
                                                <i class="bi bi-file-earmark-text-fill"></i>
                                            </div>
                                            <div class="info-content">
                                                <div class="info-box-label">Notes</div>
                                                <div class="info-box-value info-value-notes">
                                                    @(!string.IsNullOrEmpty(Model.SelectedDateRecord.Notes) ? Model.SelectedDateRecord.Notes : "-")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info mb-4">
                                <i class="bi bi-info-circle me-2"></i>
                                No OT record found for @Model.SelectedDate.Value.ToString("dd MMM yyyy").
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info mb-4">
                            <i class="bi bi-info-circle me-2"></i>
                            Please select a date to view OT details.
                        </div>
                    }

                    <!-- Select Time Period Section -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="bi bi-calendar-range me-2"></i>Select Time Period
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="get" class="d-flex align-items-end gap-2">
                                <div class="flex-grow-1">
                                    <label for="periodStartDate" class="form-label">Start Date</label>
                                    <input type="date" id="periodStartDate" name="periodStartDate" class="form-control"
                                           value="@(Model.PeriodStartDate?.ToString("yyyy-MM-dd") ?? "")">
                                </div>
                                <div class="flex-grow-1">
                                    <label for="periodEndDate" class="form-label">End Date</label>
                                    <input type="date" id="periodEndDate" name="periodEndDate" class="form-control"
                                           value="@(Model.PeriodEndDate?.ToString("yyyy-MM-dd") ?? "")">
                                </div>
                                <div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-search me-1"></i>Filter
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Period Records Table -->
                    @if (Model.PeriodRecords != null && Model.PeriodRecords.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Date</th>
                                        <th>OT Hours</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var attendance in Model.PeriodRecords.OrderByDescending(a => a.AttendanceDate))
                                    {
                                        <tr>
                                            <td>@attendance.AttendanceDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                @{
                                                    int rowOTMinutes = 0;
                                                    if (attendance.InTime.HasValue && attendance.OutTime.HasValue)
                                                    {
                                                        var inDateTime = attendance.AttendanceDate.Date + attendance.InTime.Value;
                                                        var outDateTime = attendance.AttendanceDate.Date + attendance.OutTime.Value;
                                                        if (outDateTime < inDateTime) outDateTime = outDateTime.AddDays(1);
                                                        rowOTMinutes = (int)(outDateTime - inDateTime).TotalMinutes;
                                                    }
                                                }
                                                @(rowOTMinutes > 0 ? $"{rowOTMinutes / 60:D2}:{rowOTMinutes % 60:D2}" : "-")
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(attendance.Notes))
                                                {
                                                    @attendance.Notes
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Summary Statistics - Total Overtime Only -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card bg-light" style="border: 2px solid #7c3aed;">
                                    <div class="card-body text-center py-4">
                                        <h5 class="text-muted mb-2">Total Overtime</h5>
                                        <h2 class="mb-0 text-purple fw-bold" style="color: #7c3aed; font-size: 3rem;">
                                            @{
                                                var totalOTMinutes = 0;
                                                foreach (var att in Model.PeriodRecords)
                                                {
                                                    if (att.InTime.HasValue && att.OutTime.HasValue)
                                                    {
                                                        var inDateTime = att.AttendanceDate.Date + att.InTime.Value;
                                                        var outDateTime = att.AttendanceDate.Date + att.OutTime.Value;
                                                        if (outDateTime < inDateTime) outDateTime = outDateTime.AddDays(1);
                                                        var rowOT = (int)(outDateTime - inDateTime).TotalMinutes;
                                                        totalOTMinutes += rowOT;
                                                    }
                                                }
                                                var totalOTHours = totalOTMinutes / 60;
                                                var totalOTMinutesRem = totalOTMinutes % 60;
                                            }
                                            @($"{totalOTHours:D2}:{totalOTMinutesRem:D2}")
                                        </h2>
                                        <small class="text-muted">Total overtime for selected period</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.PeriodStartDate.HasValue && Model.PeriodEndDate.HasValue)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                            <h5 class="text-muted mt-3">No OT records found.</h5>
                            <p class="text-muted">There are no OT records for the selected time period.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set max date to today for date inputs
        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];

            // Set max date for all date inputs
            const dateInputs = document.querySelectorAll('input[type="date"]');
            dateInputs.forEach(input => {
                input.max = today;
            });

            // Ensure end date is not before start date
            const periodStartDate = document.getElementById('periodStartDate');
            const periodEndDate = document.getElementById('periodEndDate');

            if (periodStartDate) {
                periodStartDate.addEventListener('change', function() {
                    if (periodEndDate) {
                        periodEndDate.min = this.value;
                    }
                });
            }
        });
    </script>
}
