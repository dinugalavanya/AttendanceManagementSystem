@model List<AttendanceManagementSystem.Controllers.UserListItemViewModel>

@{
    ViewData["Title"] = "User Management";
    Layout = "_Layout";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">

                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5>
                        <i class="bi bi-people"></i>
                        @(ViewBag.IsSuperAdmin == true ? "Admin Management" : "User Management")
                    </h5>

                    @if (ViewBag.IsSuperAdmin == true)
                    {
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-warning"
                                    data-bs-toggle="modal" data-bs-target="#changeSectionModal">
                                <i class="bi bi-arrow-left-right"></i> Change Section
                            </button>

                            <button type="button" class="btn btn-primary"
                                    data-bs-toggle="modal" data-bs-target="#createAdminModal">
                                <i class="bi bi-plus-circle"></i> ADD Admin
                            </button>

                            <button type="button" class="btn btn-success"
                                    data-bs-toggle="modal" data-bs-target="#createLeaveAgentModal">
                                <i class="bi bi-plus-circle"></i> ADD Leave Agent
                            </button>
                        </div>
                    }
                </div>

                <div class="card-body">

                    <p class="text-muted mb-3">
                        @(ViewBag.IsSuperAdmin == true ? "Showing all Admin and Leave Agent users." : "Showing live data from Users table.")
                    </p>

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">

                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Service ID</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Address</th>
                                        <th>Role</th>
                                        <th>Section</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr>
                                            <td>@user.Id</td>
                                            <td>@user.ServiceId</td>
                                            <td>@user.FullName</td>
                                            <td>@user.Email</td>
                                            <td>@(string.IsNullOrWhiteSpace(user.Phone) ? "-" : user.Phone)</td>
                                            <td>@(string.IsNullOrWhiteSpace(user.Address) ? "-" : user.Address)</td>
                                            <td>@user.RoleName</td>
                                            <td>@user.SectionName</td>

                                            <td>
                                                @if (ViewBag.IsSuperAdmin == true || ViewBag.IsAdmin == true)
                                                {
                                                    <button class="btn btn-danger btn-sm"
                                                            onclick="deleteUser('@user.ServiceId')">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-people" style="font-size:3rem;"></i>
                            <h5 class="mt-3">No users found</h5>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Change Section Modal -->
<div class="modal fade" id="changeSectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Change Admin Section</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="changeSectionForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="changeServiceId" class="form-label">Admin Service ID</label>
                        <input type="text" class="form-control" id="changeServiceId" placeholder="e.g., EMP001" required>
                        <div id="changeAdminInfo" class="mt-2 text-muted small"></div>
                    </div>
                    <div class="mb-3">
                        <label for="changeSectionSelect" class="form-label">New Section</label>
                        <select class="form-select" id="changeSectionSelect" required>
                            <option value="">Select a section</option>
                            @if (ViewBag.Sections != null)
                            {
                                @foreach (var sec in ViewBag.Sections)
                                {
                                    <option value="@sec.Id">@sec.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div id="changeError" class="text-danger small d-none"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="changeAdminSection()">Change Section</button>
            </div>
        </div>
    </div>
</div>

<!-- Create Admin Modal -->
<div class="modal fade" id="createAdminModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Admin</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createAdminForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="adminFirstName" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="adminFirstName" required>
                    </div>
                    <div class="mb-3">
                        <label for="adminLastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="adminLastName" required>
                    </div>
                    <div class="mb-3">
                        <label for="adminEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="adminEmail" required>
                    </div>
                    <div class="mb-3">
                        <label for="adminPhone" class="form-label">Phone (optional)</label>
                        <input type="text" class="form-control" id="adminPhone">
                    </div>
                    <div class="mb-3">
                        <label for="adminAddress" class="form-label">Address (optional)</label>
                        <input type="text" class="form-control" id="adminAddress">
                    </div>
                    <div class="mb-3">
                        <label for="adminSection" class="form-label">Section</label>
                        <select class="form-select" id="adminSection" required>
                            <option value="">Select a section</option>
                            @if (ViewBag.Sections != null)
                            {
                                @foreach (var sec in ViewBag.Sections)
                                {
                                    <option value="@sec.Id">@sec.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div id="errorMessage" class="text-danger small d-none"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createAdmin()">Create Admin</button>
            </div>
        </div>
    </div>
</div>

<!-- Create Leave Agent Modal -->
<div class="modal fade" id="createLeaveAgentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Leave Agent</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createLeaveAgentForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="leaveAgentFirstName" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="leaveAgentFirstName" required>
                    </div>
                    <div class="mb-3">
                        <label for="leaveAgentLastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="leaveAgentLastName" required>
                    </div>
                    <div class="mb-3">
                        <label for="leaveAgentEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="leaveAgentEmail" required>
                    </div>
                    <div class="mb-3">
                        <label for="leaveAgentPhone" class="form-label">Phone (optional)</label>
                        <input type="text" class="form-control" id="leaveAgentPhone">
                    </div>
                    <div class="mb-3">
                        <label for="leaveAgentAddress" class="form-label">Address (optional)</label>
                        <input type="text" class="form-control" id="leaveAgentAddress">
                    </div>
                    <div class="mb-3">
                        <label for="leaveAgentSection" class="form-label">Section</label>
                        <select class="form-select" id="leaveAgentSection" required>
                            <option value="">Select a section</option>
                            @if (ViewBag.Sections != null)
                            {
                                @foreach (var sec in ViewBag.Sections)
                                {
                                    <option value="@sec.Id">@sec.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div id="leaveAgentErrorMessage" class="text-danger small d-none"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="createLeaveAgent()">Create Leave Agent</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
window.deleteUser = function(serviceId) {
    console.log("deleteUser called with:", serviceId);

    if (!serviceId) {
        alert("Invalid Service ID");
        return;
    }

    if (!confirm("Are you sure you want to delete this user? This action cannot be undone.")) {
        return;
    }

    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    const token = tokenInput ? tokenInput.value : null;
    console.log("Anti-forgery token found:", !!token);

    if (!token) {
        alert("Security token not found. Please refresh the page and try again.");
        return;
    }

    fetch('/Dashboard/DeleteUser', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify({ serviceId: serviceId })
    })
    .then(response => {
        console.log("Response status:", response.status);
        if (!response.ok) {
            return response.json().then(err => {
                throw new Error(err.message || `HTTP ${response.status}`);
            });
        }
        return response.json();
    })
    .then(result => {
        console.log("Result:", result);
        if (result.success) {
            alert(result.message || "User deleted successfully");
            location.reload();
        } else {
            alert(result.message || "Delete failed");
        }
    })
    .catch(err => {
        console.error("Error:", err);
        alert("Error: " + err.message);
    });
};

// Lookup admin by Service ID
document.getElementById('changeServiceId')?.addEventListener('blur', function() {
    const serviceId = this.value.trim();
    if (serviceId) {
        fetch(`/User/LookupAdmin?serviceId=${encodeURIComponent(serviceId)}`)
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    document.getElementById('changeAdminInfo').innerHTML = 
                        `<strong>Found:</strong> ${result.fullName} (${result.serviceId}) - Current: ${result.sectionName}`;
                } else {
                    document.getElementById('changeAdminInfo').innerHTML = 
                        `<span class="text-danger">${result.message}</span>`;
                }
            })
            .catch(err => {
                document.getElementById('changeAdminInfo').innerHTML = 
                    `<span class="text-danger">Error looking up admin</span>`;
            });
    }
});

// Change Admin Section
window.changeAdminSection = function() {
    const serviceId = document.getElementById('changeServiceId').value.trim();
    const sectionId = document.getElementById('changeSectionSelect').value;
    const errorDiv = document.getElementById('changeError');

    if (!serviceId) {
        errorDiv.textContent = 'Please enter a Service ID';
        errorDiv.classList.remove('d-none');
        return;
    }

    if (!sectionId) {
        errorDiv.textContent = 'Please select a section';
        errorDiv.classList.remove('d-none');
        return;
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    fetch('/User/ChangeAdminSection', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token || ''
        },
        body: JSON.stringify({ serviceId: serviceId, sectionId: parseInt(sectionId) })
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            alert(result.message);
            bootstrap.Modal.getInstance(document.getElementById('changeSectionModal')).hide();
            location.reload();
        } else {
            errorDiv.textContent = result.message;
            errorDiv.classList.remove('d-none');
        }
    })
    .catch(err => {
        errorDiv.textContent = 'Error: ' + err.message;
        errorDiv.classList.remove('d-none');
    });
};

// Create Admin
window.createAdmin = function() {
    const firstName = document.getElementById('adminFirstName').value.trim();
    const lastName = document.getElementById('adminLastName').value.trim();
    const email = document.getElementById('adminEmail').value.trim();
    const phone = document.getElementById('adminPhone').value.trim();
    const address = document.getElementById('adminAddress').value.trim();
    const sectionId = document.getElementById('adminSection').value;
    const errorDiv = document.getElementById('errorMessage');

    if (!firstName || !lastName || !email || !sectionId) {
        errorDiv.textContent = 'Please fill in all required fields';
        errorDiv.classList.remove('d-none');
        return;
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    fetch('/User/CreateAdmin', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token || ''
        },
        body: JSON.stringify({
            firstName: firstName,
            lastName: lastName,
            email: email,
            phone: phone || null,
            address: address || null,
            sectionId: parseInt(sectionId)
        })
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            alert(result.message);
            bootstrap.Modal.getInstance(document.getElementById('createAdminModal')).hide();
            location.reload();
        } else {
            errorDiv.textContent = result.message;
            errorDiv.classList.remove('d-none');
        }
    })
    .catch(err => {
        errorDiv.textContent = 'Error: ' + err.message;
        errorDiv.classList.remove('d-none');
    });
};

// Create Leave Agent
window.createLeaveAgent = function() {
    const firstName = document.getElementById('leaveAgentFirstName').value.trim();
    const lastName = document.getElementById('leaveAgentLastName').value.trim();
    const email = document.getElementById('leaveAgentEmail').value.trim();
    const phone = document.getElementById('leaveAgentPhone').value.trim();
    const address = document.getElementById('leaveAgentAddress').value.trim();
    const sectionId = document.getElementById('leaveAgentSection').value;
    const errorDiv = document.getElementById('leaveAgentErrorMessage');

    if (!firstName || !lastName || !email || !sectionId) {
        errorDiv.textContent = 'Please fill in all required fields';
        errorDiv.classList.remove('d-none');
        return;
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    fetch('/User/CreateLeaveAgent', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token || ''
        },
        body: JSON.stringify({
            firstName: firstName,
            lastName: lastName,
            email: email,
            phone: phone || null,
            address: address || null,
            sectionId: parseInt(sectionId)
        })
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            alert(result.message);
            bootstrap.Modal.getInstance(document.getElementById('createLeaveAgentModal')).hide();
            location.reload();
        } else {
            errorDiv.textContent = result.message;
            errorDiv.classList.remove('d-none');
        }
    })
    .catch(err => {
        errorDiv.textContent = 'Error: ' + err.message;
        errorDiv.classList.remove('d-none');
    });
};
</script>
}