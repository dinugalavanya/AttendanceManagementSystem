@model List<AttendanceManagementSystem.Controllers.UserListItemViewModel>
@{
    ViewData["Title"] = "User Management";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5><i class="bi bi-people"></i> @(ViewBag.IsSuperAdmin == true ? "Admin Management" : "User Management")</h5>
                    @if (ViewBag.IsSuperAdmin == true)
                    {
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#changeSectionModal">
                                <i class="bi bi-arrow-left-right"></i> Change Section
                            </button>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAdminModal">
                                <i class="bi bi-plus-circle"></i> ADD Admin
                            </button>
                        </div>
                    }
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">@(ViewBag.IsSuperAdmin == true ? "Showing all Admin users." : "Showing live data from the Users table.")</p>

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Service ID</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Address</th>
                                        <th>Role</th>
                                        <th>Section</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr>
                                            <td>@user.Id</td>
                                            <td>@user.ServiceId</td>
                                            <td>@user.FullName</td>
                                            <td>@user.Email</td>
                                            <td>@(string.IsNullOrWhiteSpace(user.Phone) ? "-" : user.Phone)</td>
                                            <td>@(string.IsNullOrWhiteSpace(user.Address) ? "-" : user.Address)</td>
                                            <td>@user.RoleName</td>
                                            <td>@user.SectionName</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-people" style="font-size: 3rem; color: var(--primary-color);"></i>
                            <h5 class="mt-3">No users found</h5>
                            <p class="text-muted">No records are currently available in the Users table.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Change Section Modal -->
@if (ViewBag.IsSuperAdmin == true)
{
    <div class="modal fade" id="changeSectionModal" tabindex="-1" aria-labelledby="changeSectionModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="changeSectionModalLabel"><i class="bi bi-arrow-left-right"></i> Change Admin Section</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Step 1: Enter Service ID -->
                    <div id="stepLookup">
                        <div class="mb-3">
                            <label for="lookupServiceId" class="form-label">Admin Service ID *</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="lookupServiceId" placeholder="e.g. EMP901">
                                <button class="btn btn-outline-primary" type="button" onclick="lookupAdmin()">Find Admin</button>
                            </div>
                        </div>
                        <div id="lookupError" class="alert alert-danger d-none"></div>
                    </div>
                    <!-- Step 2: Change Section (shown after lookup) -->
                    <div id="stepChange" class="d-none">
                        <div class="alert alert-info mb-3" id="adminInfo"></div>
                        <div class="mb-3">
                            <label for="newSectionId" class="form-label">New Section *</label>
                            <select class="form-select" id="newSectionId">
                                <option value="">-- Select Section --</option>
                                @{
                                    var sectionListCs = ViewBag.Sections as List<AttendanceManagementSystem.Models.Section>;
                                }
                                @if (sectionListCs != null)
                                {
                                    foreach (var sec in sectionListCs)
                                    {
                                        <option value="@sec.Id">@sec.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div id="changeError" class="alert alert-danger d-none"></div>
                        <div id="changeSuccess" class="alert alert-success d-none"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning d-none" id="btnChangeSection" onclick="changeSection()">Change Section</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let foundAdminServiceId = null;

        function lookupAdmin() {
            const serviceId = document.getElementById('lookupServiceId').value.trim();
            document.getElementById('lookupError').classList.add('d-none');

            if (!serviceId) {
                document.getElementById('lookupError').textContent = 'Please enter a Service ID.';
                document.getElementById('lookupError').classList.remove('d-none');
                return;
            }

            fetch(`/User/LookupAdmin?serviceId=${encodeURIComponent(serviceId)}`)
                .then(r => r.json())
                .then(result => {
                    if (result.success) {
                        foundAdminServiceId = serviceId;
                        document.getElementById('adminInfo').textContent =
                            `Found: ${result.fullName} (${result.serviceId}) — Current Section: ${result.sectionName}`;
                        document.getElementById('stepChange').classList.remove('d-none');
                        document.getElementById('btnChangeSection').classList.remove('d-none');
                    } else {
                        document.getElementById('lookupError').textContent = result.message;
                        document.getElementById('lookupError').classList.remove('d-none');
                        document.getElementById('stepChange').classList.add('d-none');
                        document.getElementById('btnChangeSection').classList.add('d-none');
                        foundAdminServiceId = null;
                    }
                })
                .catch(() => {
                    document.getElementById('lookupError').textContent = 'Error looking up admin.';
                    document.getElementById('lookupError').classList.remove('d-none');
                });
        }

        function changeSection() {
            const sectionId = document.getElementById('newSectionId').value;
            document.getElementById('changeError').classList.add('d-none');
            document.getElementById('changeSuccess').classList.add('d-none');

            if (!sectionId) {
                document.getElementById('changeError').textContent = 'Please select a section.';
                document.getElementById('changeError').classList.remove('d-none');
                return;
            }

            fetch('/User/ChangeAdminSection', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ serviceId: foundAdminServiceId, sectionId: parseInt(sectionId) })
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) {
                    document.getElementById('changeSuccess').textContent = result.message;
                    document.getElementById('changeSuccess').classList.remove('d-none');
                    setTimeout(() => {
                        bootstrap.Modal.getInstance(document.getElementById('changeSectionModal')).hide();
                        location.reload();
                    }, 1500);
                } else {
                    document.getElementById('changeError').textContent = result.message;
                    document.getElementById('changeError').classList.remove('d-none');
                }
            })
            .catch(() => {
                document.getElementById('changeError').textContent = 'Error changing section.';
                document.getElementById('changeError').classList.remove('d-none');
            });
        }

        document.getElementById('changeSectionModal').addEventListener('hidden.bs.modal', function () {
            document.getElementById('lookupServiceId').value = '';
            document.getElementById('lookupError').classList.add('d-none');
            document.getElementById('stepChange').classList.add('d-none');
            document.getElementById('btnChangeSection').classList.add('d-none');
            document.getElementById('changeError').classList.add('d-none');
            document.getElementById('changeSuccess').classList.add('d-none');
            foundAdminServiceId = null;
        });
    </script>
}

<!-- Create Admin Modal -->
@if (ViewBag.IsSuperAdmin == true)
{
    <div class="modal fade" id="createAdminModal" tabindex="-1" aria-labelledby="createAdminModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createAdminModalLabel">Create Admin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="createAdminForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="FirstName" class="form-label">First Name *</label>
                                <input type="text" class="form-control" id="FirstName" name="FirstName" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="LastName" class="form-label">Last Name *</label>
                                <input type="text" class="form-control" id="LastName" name="LastName" required>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Email" class="form-label">Email *</label>
                                <input type="email" class="form-control" id="Email" name="Email" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="Phone" class="form-label">Phone</label>
                                <input type="tel" class="form-control" id="Phone" name="Phone">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="SectionId" class="form-label">Section *</label>
                                <select class="form-select" id="SectionId" name="SectionId" required>
                                    <option value="">-- Select Section --</option>
                                    @{
    var sectionList = ViewBag.Sections as List<AttendanceManagementSystem.Models.Section>;
}
@if (sectionList != null)
{
    foreach (var sec in sectionList)
    {
        <option value="@sec.Id">@sec.Name</option>
    }
}
                                </select>
                            </div>
                        </div>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> A secure temporary password will be auto-generated and sent to the admin's email address.
                        </div>
                        <div class="mb-3">
                            <label for="Address" class="form-label">Address</label>
                            <textarea class="form-control" id="Address" name="Address" rows="3"></textarea>
                        </div>
                        <div id="errorMessage" class="alert alert-danger d-none"></div>
                        <div id="successMessage" class="alert alert-success d-none"></div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="createAdmin()">Create Admin</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function createAdmin() {
            const form = document.getElementById('createAdminForm');
            const formData = new FormData(form);
            
            // Clear previous messages
            document.getElementById('errorMessage').classList.add('d-none');
            document.getElementById('successMessage').classList.add('d-none');
            
            // Create JSON payload
            const data = {
                FirstName: formData.get('FirstName'),
                LastName: formData.get('LastName'),
                Email: formData.get('Email'),
                Phone: formData.get('Phone') || null,
                Address: formData.get('Address') || null,
                SectionId: formData.get('SectionId') ? parseInt(formData.get('SectionId')) : null
            };
            
            fetch('/User/CreateAdmin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    document.getElementById('successMessage').textContent = result.message || 'Admin created successfully';
                    document.getElementById('successMessage').classList.remove('d-none');
                    
                    // Close modal and refresh page after 2 seconds
                    setTimeout(() => {
                        const modal = bootstrap.Modal.getInstance(document.getElementById('createAdminModal'));
                        if (modal) modal.hide();
                        location.reload();
                    }, 2000);
                } else {
                    document.getElementById('errorMessage').textContent = result.message || 'Error creating admin';
                    document.getElementById('errorMessage').classList.remove('d-none');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById('errorMessage').textContent = 'An error occurred while creating admin.';
                document.getElementById('errorMessage').classList.remove('d-none');
            });
        }
    </script>
}
