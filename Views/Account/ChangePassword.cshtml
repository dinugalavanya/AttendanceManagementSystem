@{
    ViewData["Title"] = "Change Password";
}

<div class="auth-card">
    <div class="auth-brand">
        <div class="brand-icon"><i class="bi bi-key-fill"></i></div>
        <div>
            <h2>Change Password</h2>
            <p>Update your password</p>
        </div>
    </div>

    <form id="changePasswordForm" class="auth-form">
        <div class="mb-3">
            <label for="currentPassword" class="form-label">Current Password</label>
            <input type="password" class="form-control" id="currentPassword" name="currentPassword" required />
        </div>

        <div class="mb-3">
            <label for="newPassword" class="form-label">New Password</label>
            <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="6" />
            <div class="form-text">Password must be at least 6 characters.</div>
        </div>

        <div class="mb-3">
            <label for="confirmPassword" class="form-label">Confirm New Password</label>
            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="6" />
        </div>

        <div id="changePasswordAlert" class="alert d-none" role="alert"></div>

        <button type="submit" class="btn btn-primary w-100">
            <span id="changePasswordSpinner" class="spinner-border spinner-border-sm d-none me-2"></span>
            Change Password
        </button>

        <div class="mt-3 text-center">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-link">Back to Dashboard</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('changePasswordForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const currentPassword = document.getElementById('currentPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const alert = document.getElementById('changePasswordAlert');
            const spinner = document.getElementById('changePasswordSpinner');
            const submitBtn = this.querySelector('button[type="submit"]');

            // Client-side validation
            if (newPassword !== confirmPassword) {
                alert.className = 'alert alert-danger';
                alert.textContent = 'Passwords do not match.';
                alert.classList.remove('d-none');
                return;
            }

            if (newPassword.length < 6) {
                alert.className = 'alert alert-danger';
                alert.textContent = 'New password must be at least 6 characters.';
                alert.classList.remove('d-none');
                return;
            }

            // Show loading state
            spinner.classList.remove('d-none');
            submitBtn.disabled = true;
            alert.classList.add('d-none');

            try {
                const response = await fetch('/Account/ChangePassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({
                        currentPassword: currentPassword,
                        newPassword: newPassword,
                        confirmPassword: confirmPassword
                    })
                });

                const result = await response.json();

                if (result.success) {
                    alert.className = 'alert alert-success';
                    alert.textContent = result.message;
                    alert.classList.remove('d-none');
                    
                    // Clear form
                    document.getElementById('changePasswordForm').reset();
                    
                    // Redirect to dashboard after 2 seconds
                    setTimeout(() => {
                        window.location.href = '/Dashboard/Index';
                    }, 2000);
                } else {
                    alert.className = 'alert alert-danger';
                    alert.textContent = result.message;
                    alert.classList.remove('d-none');
                }
            } catch (error) {
                alert.className = 'alert alert-danger';
                alert.textContent = 'An error occurred. Please try again.';
                alert.classList.remove('d-none');
            } finally {
                spinner.classList.add('d-none');
                submitBtn.disabled = false;
            }
        });
    </script>
}
